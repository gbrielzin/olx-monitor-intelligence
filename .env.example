# Copie este arquivo para .env e preencha com seus valores reais.
# O .env nunca deve ser commitado -- já está no .gitignore.

# --- Telegram (opcional) ---
# Crie um bot com @BotFather no Telegram para gerar o token.
# O chat_id é o seu ID de usuário ou de um grupo (veja @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alvo da coleta ---
# OLX_SEARCH_URL (monitor) e COMPUTADOR_SEARCH_URL existem só porque o
# código ainda existe -- essas duas categorias pararam de ser agendadas
# (mercado se mostrou ineficaz). O foco atual é só iPhone, ver
# IPHONE_REGIOES abaixo.
OLX_SEARCH_URL=https://www.olx.com.br/informatica/monitores/estado-es?q=monitor
COMPUTADOR_SEARCH_URL=https://www.olx.com.br/estado-es?q=computador%20completo
SCRAPE_INTERVAL_MINUTES=30
MAX_PAGINAS=10

# --- iPhone: regiões (estados) onde o scraper roda, cada uma podendo ter
# seu próprio grupo do Telegram. Lista JSON -- sem essa variável, roda só
# a região pessoal (ES) no chat pessoal (TELEGRAM_CHAT_ID acima), igual
# hoje. Pra adicionar um estado novo com grupo público: crie o grupo no
# Telegram, adicione o bot, mande uma mensagem nele, pegue o chat_id em
# https://api.telegram.org/bot<TOKEN>/getUpdates, e acrescente uma entrada
# na lista abaixo (publico é só documentação, não muda comportamento).
# IPHONE_REGIOES=[{"uf":"ES","nome":"Espírito Santo","chat_id":"123456","publico":false},{"uf":"SP","nome":"São Paulo","chat_id":"-987654","publico":true}]

# --- Auditoria de anúncios novos via IA (opcional, custa por chamada) ---
# Compara título x campos extraídos de cada anúncio NOVO via LLM, flagra
# inconsistência -- ver scraper/auditoria_ia.py. Desativado por padrão;
# pra ligar, preencha ANTHROPIC_API_KEY e mude IA_AUDITORIA_ATIVA pra true.
IA_AUDITORIA_ATIVA=false
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5

# --- Resumo diário agentic (opcional, custa 1 chamada de IA por dia) ---
# Reaproveita ANTHROPIC_API_KEY/IA_MODELO acima. Junta oportunidades +
# tendência de preço de iPhone (todas as regiões) e manda um resumo por
# Telegram de manhã -- ver scraper/resumo_diario.py.
RESUMO_DIARIO_ATIVO=false
RESUMO_DIARIO_HORA_UTC=11

# --- Banco de dados (caminho DENTRO do container -- não mude sem
#     ajustar também o volume no docker-compose.yml) ---
DB_PATH=/data/olx_monitor.db

# --- Pipeline em camadas com Prefect (opcional, ver README) ---
# Só flows/pipeline_olx.py lê isto; o scraper do docker-compose ignora.
# "local" = bronze/prata/ouro numa pasta; "s3" = bucket compatível com S3.
LAKE_BACKEND=local
LAKE_DIR=data/lake
OURO_DB_PATH=data/ouro.db
# Pra usar o MinIO local (docker-compose --profile lake up minio):
# LAKE_BACKEND=s3
# LAKE_S3_ENDPOINT_URL=http://localhost:9000
LAKE_S3_BUCKET=olx-lake
LAKE_S3_REGIAO=us-east-1
# Credenciais: no MinIO, as mesmas de MINIO_ROOT_USER/MINIO_ROOT_PASSWORD
# abaixo. Na AWS de verdade, deixe vazio e use o perfil/variáveis padrão da
# AWS. NUNCA coloque chave real neste arquivo (.env.example vai pro GitHub).
LAKE_S3_ACCESS_KEY=
LAKE_S3_SECRET_KEY=
# Usuário/senha do MinIO local (invente os seus; mínimo 8 caracteres na senha)
MINIO_ROOT_USER=troque-este-usuario
MINIO_ROOT_PASSWORD=troque-esta-senha
# Imagem do MinIO (ver comentário no docker-compose.yml)
# MINIO_IMAGE=quay.io/minio/minio:latest
